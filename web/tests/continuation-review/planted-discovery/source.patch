+//! Session-only exact paid-founder receipt. No search, replacement or save field.
+const std=@import("std");
+pub const Receipt=struct {
+ owner:usize=0,storage:usize=0,world:u32=0,cell:usize=0,id:u64=0,
+ pub fn record(self:*Receipt,state:anytype,world:u32,cell:usize,id:u64)void{self.*=.{.owner=@intFromPtr(&state.planet),.storage=@intFromPtr(state.planet.microbeCells.ptr),.world=world,.cell=cell,.id=id};}
+ pub fn view(self:*const Receipt,state:anytype,world:u32,expected:u32,cell:usize,text:[]const u8,width:f32,height:f32)i32 {
+  if(self.id==0 or world!=expected or world!=self.world or cell!=self.cell or self.owner!=@intFromPtr(&state.planet) or self.storage!=@intFromPtr(state.planet.microbeCells.ptr))return 0;
+  if(text.len==0 or text.len>20 or text[0]=='0')return 0;for(text)|c|if(c<'0' or c>'9')return 0;
+  const id=std.fmt.parseInt(u64,text,10) catch return 0;if(id!=self.id)return 0;
+  return state.visitExactColony(cell,id,width,height);
+ }
+};
