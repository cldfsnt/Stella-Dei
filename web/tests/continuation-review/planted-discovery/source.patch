+const p={world_serial:7,cell:9,token:11,status:'eligible',founder_id:'9007199254740993',carbon_kg_m2:.02,nitrogen_kg_m2:.002,carbon_source_kg:200,carbon_rounding_kg:.000001,support_kg_c_m2:.005,root_kg_c_m2:.0025,root_fraction:.5,organization:.25,structure:0,soil_kg_m2:.4,depth_m:.001};
+function setup(){let reads=0,views=[],inspect=0,offers=[],messages=[],result=1,available=true;const h={available:()=>available,snapshot:()=>({status:'wetlands',enabled:true,physiology_law:3,world_serial:7,cell:9,root_allocations:++reads>=3?[{id:p.founder_id,living:true,fraction:.5}]:[]}),preview:()=>p,confirm:()=>true,apply:()=>({...p,status:'planted'}),cancel:()=>{},busy:()=>{},report:m=>messages.push(m),offerView:v=>offers.push(v),inspect:()=>inspect++,view:(...a)=>{views.push(a);if(result==='throw')throw Error();return result;}};return {c:R.create(h),views,offers,messages,get inspected(){return inspect},result:r=>result=r,available:v=>available=v};}
