+fn qaDepthTargets(st:*@import("states/play.zig").PlayState, color_only:bool)!void {
+ const F=@import("renderer.zig").Framebuffer;
+ const w=st.bloomFramebuffer.width;const h=st.bloomFramebuffer.height;
+ const a=if(color_only)try F.createColorOnly(w,h) else try F.create(w,h);
+ errdefer a.deinit();
+ const b=if(color_only)try F.createColorOnly(w,h) else try F.create(w,h);
+ st.bloomFramebuffer.deinit();st.blurFramebuffer.deinit();st.bloomFramebuffer=a;st.blurFramebuffer=b;
+ std.debug.assert(st.framebuffer.depthTexture!=0);
+ std.debug.assert((a.depthTexture==0)==color_only and (b.depthTexture==0)==color_only);
+}
+fn qaDepthLifecycle() !void {
