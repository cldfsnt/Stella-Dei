+   f.bind();var attachment:c_int=0;gl.getFramebufferAttachmentParameteriv(gl.FRAMEBUFFER,gl.DEPTH_ATTACHMENT,gl.FRAMEBUFFER_ATTACHMENT_OBJECT_NAME,&attachment);f.unbind();
+   std.debug.assert((attachment!=0)==depth);std.debug.assert(gl.isFramebuffer(f.fbo)!=0 and gl.isTexture(f.colorTextures[0])!=0);
+   if(depth)std.debug.assert(gl.isTexture(f.depthTexture)!=0);
+   f.deinit();std.debug.assert(gl.isFramebuffer(f.fbo)==0 and gl.isTexture(f.colorTextures[0])==0);if(depth)std.debug.assert(gl.isTexture(f.depthTexture)==0);
+   R.qa_fail_fbo=true;const failed=if(depth)F.create(dims[0],dims[1]) else F.createColorOnly(dims[0],dims[1]);R.qa_fail_fbo=false;
+   if(failed)|unexpected|{unexpected.deinit();return error.ExpectedFailure;}else|err|{std.debug.assert(err==error.IncompleteFramebuffer);}
+   std.debug.assert(gl.isFramebuffer(R.qa_last_fbo)==0 and gl.isTexture(R.qa_last_color)==0);if(depth)std.debug.assert(gl.isTexture(R.qa_last_depth)==0);
