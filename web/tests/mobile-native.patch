+//! Browser chrome ownership is session-only, never a save field.
+const std=@import("std");
+pub var enabled=false;
+pub var top:f32=0;
+pub var bottom:f32=0;
+pub fn set(on:i32,t:f32,b:f32)bool{if((on!=0 and on!=1) or !std.math.isFinite(t) or !std.math.isFinite(b) or t<0 or b<0 or t>240 or b>240)return false;enabled=on==1;top=t;bottom=b;return true;}
+// Find creates a real 84px Peek panel; reserve it for framing, not terrain hit exclusion.
+pub fn frameReserve()f32{return if(enabled) 2*@max(top,@max(bottom,84))+40 else 220;}
